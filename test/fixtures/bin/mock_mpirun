#!/usr/bin/env bash
# Mock mpirun for unit tests. Honors MOCK_MPI_MAX_SLOTS (default 16).
set -euo pipefail
max="${MOCK_MPI_MAX_SLOTS:-16}"
nproc=1
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -np)
      nproc="$2"
      shift 2
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
if (( nproc > max )); then
  echo "mock_mpirun: not enough slots (${nproc} > ${max})" >&2
  exit 1
fi
export AYIL_MOCK_NPROC="${nproc}"
exec "${args[@]}"
