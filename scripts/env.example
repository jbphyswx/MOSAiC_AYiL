# Copy to scripts/env.local and edit for your machine (env.local is gitignored).
#
#   cp scripts/env.example scripts/env.local
#
# Then: source scripts/env.local   OR   ./scripts/reproduce.sh  (loads env.local automatically)

# Open MPI (if not under /usr/lib64/openmpi/bin):
# export OPENMPI_PREFIX=/usr/lib64/openmpi

# NetCDF include path for CMake (if findnetcdf fails):
# export NETCDF_INCLUDE=/path/to/netcdf/include

# MPI ranks: leave unset to auto-detect on each machine. Must divide grid 320.
# export DALES_DEFAULT_NPROC=64
# export DALES_NPROC=40
# export AYIL_PROGRESS_INTERVAL=30
# export AYIL_MPIRUN_EXTRA="--oversubscribe"
# export AYIL_MPI_MAX_SLOTS=48   # optional cap before auto-detect

# Optional path overrides:
# export MOSAiC_AYIL_ROOT=/path/to/MOSAiC_AYIL
# export AYIL_RUNS=${MOSAiC_AYIL_ROOT}/runs
# export AYIL_INPUTS=${MOSAiC_AYIL_ROOT}/ayil_config_input_results
#
# Zenodo artifacts (~870 MiB zip): fetched on first prepare_case; rsync --ignore-existing
# keeps git-tracked ayil_config_input_results/*/namoptions (does not overwrite).
# export AYIL_ZENODO_CACHE=${MOSAiC_AYIL_ROOT}/.cache/zenodo
# export AYIL_SKIP_ZENODO_FETCH=1   # air-gap: copy missing NetCDF/.001 files manually
# curl (60) SSL on login nodes (common with conda base): use system CA bundle
# export CURL_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt

# --- Slurm (./scripts/slurm_submit.sh) ---
# Defaults match Caltech Resnick HPC (https://www.hpc.caltech.edu/resources); override elsewhere.
# export AYIL_SLURM_NTASKS=40
# export AYIL_SLURM_TIME=08:00:00
# export AYIL_SLURM_MEM=128G
# export AYIL_SLURM_ARRAY_MAX=8      # optional: cap concurrent array tasks (--array=0-N%8)
# export AYIL_SLURM_PARTITION=        # leave empty for cluster default
# export AYIL_SLURM_ACCOUNT=
# export AYIL_SLURM_EXTRA=            # e.g. --constraint=icelake
# export AYIL_SLURM_BUILD=0           # 1 = compile dales4 inside each job if missing
#
# --- Caltech Resnick (login*.hpc.caltech.edu) ---
# Spack modules use hashed suffixes; short names like gcc/11.3.1 often do not exist.
# netcdf-fortran *gcc-11.3.1* pulls gcc, openmpi, hdf5, netcdf-c as dependencies.
# Do NOT load netcdf-fortran *oneapi* (brings Intel MPI and breaks gfortran + mpif90).
#
#   module purge
#   module load netcdf-fortran/4.6.1-gcc-11.3.1-gf5h6j2
#   module load cmake
#
# Verify before build:  which mpif90   (path should contain openmpi, not intel-oneapi-mpi)
#
# Generic clusters (if short names exist):
#   module load gcc openmpi netcdf-fortran cmake
