# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files generated by BinaryProvider / BinDeps
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Documenter
docs/build/
docs/site/

# Resolved package manifests — pin versions via Project.toml [compat]
Manifest*.toml

# ignore vscode and macos artifacts
*.vscode
*.DS

# ignore simulation outputs
*.json
*.in
*.vtu
*.nc
*.mp4
*.png
*.hdf5
*.h5
*.g
*.lock
*.loc
*.out
*.log
*.jld2
*.dat

# the docs figures are checked in; the README and index.md link to them
!docs/src/assets/*.png


# misc
.DS_Store
.qodo
.agents

# generated artifact tarballs (gen/build_data_artifact.jl)
*.tar.gz
